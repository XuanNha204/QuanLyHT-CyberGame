<UserControl x:Class="CyberGame.MemberClient.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:enums="clr-namespace:CyberGame.Domain.Enums;assembly=CyberGame.Domain"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1280"
             Background="{StaticResource BackgroundBrush}"
             Loaded="LoginView_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CYBERGAME" FontWeight="Bold" FontSize="17" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="CHỌN MÁY &amp; ĐĂNG NHẬP HỘI VIÊN" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#143524" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold">
                            <Run Text="Máy trống: "/><Run Text="{Binding AvailableMachineCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                    <TextBlock Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Run Text="Tổng số máy: "/><Run Text="{Binding TotalMachineCount, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="Làm mới"
                            Command="{Binding RefreshMachinesCommand}"
                            Style="{StaticResource OutlineButton}"
                            Height="34"
                            Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,18,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="1. Chọn máy muốn sử dụng" Style="{StaticResource Heading2}"/>
                        <TextBlock Text="Chỉ máy có trạng thái Sẵn sàng mới có thể chọn. Trạng thái được đồng bộ tự động với máy quản lý."
                                   Style="{StaticResource CaptionText}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Machines}"
                                 SelectedItem="{Binding SelectedMachine, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 KeyboardNavigation.TabNavigation="Cycle">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="6"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Cursor" Value="No"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SelectionBorder"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="2"
                                                        CornerRadius="10"
                                                        Padding="2">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                        <Setter TargetName="SelectionBorder" Property="Background" Value="#172E55"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static enums:MachineStatus.Available}">
                                            <Setter Property="IsEnabled" Value="True"/>
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="180"
                                            MinHeight="126"
                                            Background="{StaticResource ElevatedSurfaceBrush}"
                                            BorderBrush="{Binding Status, Converter={StaticResource MachineStatusBrushConverter}}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SecondaryBodyText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding GroupName}" Style="{StaticResource CaptionText}" Margin="0,2,0,8"/>
                                            <Border Background="{Binding Status, Converter={StaticResource MachineStatusBadgeBgConverter}}"
                                                    BorderBrush="{Binding Status, Converter={StaticResource MachineStatusBrushConverter}}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource MachineStatusTextConverter}}"
                                                           Foreground="{Binding Status, Converter={StaticResource MachineStatusBrushConverter}}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <Border Grid.Row="2" Background="{StaticResource ElevatedSurfaceBrush}" CornerRadius="6" Padding="12,9" Margin="0,14,0,0">
                        <TextBlock Text="Máy đang sử dụng, bảo trì hoặc ngoại tuyến được làm mờ và không thể chọn."
                                   Style="{StaticResource CaptionText}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Padding="30,28">
                <StackPanel>
                    <TextBlock Text="2. Đăng nhập hội viên" Style="{StaticResource Heading1}"/>
                    <TextBlock Text="Phiên chơi sẽ tự động bắt đầu sau khi thông tin hợp lệ."
                               Style="{StaticResource CaptionText}"
                               Margin="0,4,0,20"/>

                    <Border Background="{StaticResource ElevatedSurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding SelectedMachineText}"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="#2D1515"
                            BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="Mã hội viên" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtMemberCode"
                             Text="{Binding MemberCode, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardTextBox}"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="Mã PIN (6 chữ số)" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <PasswordBox x:Name="TxtPin"
                                 Style="{StaticResource StandardPasswordBox}"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 MaxLength="6"
                                 Margin="0,0,0,22"/>

                    <Button Content="ĐĂNG NHẬP &amp; BẮT ĐẦU PHIÊN"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding HasSelectedMachine}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButton}"
                            Height="46"
                            FontSize="14"
                            Margin="0,0,0,16"/>

                    <Border Background="#3D2A05" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="Cần có số dư ví và ca trực đang mở. Tài khoản sẽ khóa tạm thời nếu nhập sai PIN 5 lần liên tiếp."
                                   Foreground="{StaticResource WarningBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
