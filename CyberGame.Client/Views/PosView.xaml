<UserControl x:Class="CyberGame.Client.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Categories & Product Catalog -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Bán hàng &amp; Dịch vụ (POS)" Style="{StaticResource Heading1}"/>
                    <TextBlock Text="Gọi đồ ăn, thức uống phục vụ trực tiếp tại máy trạm hoặc bán lẻ" Style="{StaticResource MutedText}"/>
                </StackPanel>
                <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <!-- Category Selector Tabs -->
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding Categories}" 
                     SelectedItem="{Binding SelectedCategory}"
                     Margin="0,0,0,16"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,8,0"/>
                        <Setter Property="Padding" Value="14,8"/>
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Product Items Grid -->
            <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Width="160"
                                        Height="120"
                                        Margin="8"
                                        Padding="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Unit, StringFormat='Đơn vị: {0}'}" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>

                                        <TextBlock Grid.Row="2" 
                                                   Text="{Binding SalePrice, Converter={StaticResource CurrencyConverter}}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="14" 
                                                   Foreground="{StaticResource AccentBrush}" 
                                                   VerticalAlignment="Center"/>

                                        <Button Grid.Row="3" 
                                                Content="+ Thêm vào giỏ" 
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource OutlineButton}" 
                                                Height="28" 
                                                FontSize="11"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Right: Cart & Checkout Panel -->
        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardPanel}" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cart Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Giỏ hàng hiện tại" Style="{StaticResource Heading2}"/>
                    <Button Content="Xóa giỏ" Command="{Binding ClearCartCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" Height="28" FontSize="11"/>
                </Grid>

                <!-- Target Destination (Active Station or Retail) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Gắn đơn vào máy trạm đang chơi:" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ActiveSessions}" 
                              SelectedItem="{Binding SelectedSessionTarget}" 
                              DisplayMemberPath="MachineCode" 
                              Margin="0,0,0,4"/>
                    <TextBlock Text="Để trống nếu bán trực tiếp tại quầy thanh toán" Style="{StaticResource MutedText}"/>
                </StackPanel>

                <!-- Cart Items List -->
                <DataGrid Grid.Row="2" 
                          ItemsSource="{Binding CartItems}" 
                          IsReadOnly="True"
                          Margin="0,0,0,16">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mặt hàng" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" Width="80"/>
                        <DataGridTemplateColumn Header="SL" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="-" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="18" Height="22" Margin="0,0,2,0"/>
                                        <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" FontWeight="Bold" Margin="4,0"/>
                                        <Button Content="+" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="18" Height="22" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Thành tiền" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Bottom Checkout Area -->
                <StackPanel Grid.Row="3">
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                        <Grid>
                            <TextBlock Text="TỔNG TIỀN ĐƠN:" Style="{StaticResource BodyText}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CartTotal, Converter={StaticResource CurrencyConverter}}" 
                                       Style="{StaticResource Heading1}" 
                                       Foreground="{StaticResource AccentBrush}" 
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Alerts -->
                    <Border Background="#FEF2F2" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"/>
                    </Border>
                    <Border Background="#F0FDF4" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8"
                            Visibility="{Binding HasSuccess, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" FontSize="12"/>
                    </Border>

                    <Button Content="XÁC NHẬN ĐẶT HÀNG" 
                            Command="{Binding CheckoutCommand}" 
                            Style="{StaticResource PrimaryButton}" 
                            Height="44" 
                            FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Orders requested from MemberClient -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CardPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="Đơn món từ máy hội viên" Style="{StaticResource Heading2}"/>
                        <TextBlock Text="Đơn tiền mặt chờ thu tiền rồi duyệt. Đơn ví đã trừ tiền sẽ tự động chuyển sang Đang chuẩn bị." Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <Button Content="Làm mới hàng đợi" Command="{Binding RefreshServiceOrdersCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right"/>
                </Grid>

                <TabControl Grid.Row="1">
                    <TabItem Header="Chờ duyệt">
                        <DataGrid ItemsSource="{Binding PendingMemberOrders}" IsReadOnly="True" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderNumber}" Width="130"/>
                                <DataGridTextColumn Header="Máy" Binding="{Binding MachineCode}" Width="75"/>
                                <DataGridTextColumn Header="Hội viên" Binding="{Binding CustomerName}" Width="140"/>
                                <DataGridTemplateColumn Header="Món yêu cầu" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ProductName, StringFormat='{}{0}'}" ToolTip="{Binding Note}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                                <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentMethod, Converter={StaticResource PaymentMethodTextConverter}}" Width="100"/>
                                <DataGridTextColumn Header="Tình trạng tiền" Binding="{Binding PaymentStatus, Converter={StaticResource PaymentStatusTextConverter}}" Width="115"/>
                                <DataGridTemplateColumn Header="Xử lý" Width="235">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="ĐÃ THU TIỀN &amp; DUYỆT" Command="{Binding DataContext.ApproveOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Height="26" Padding="8,2" Margin="0,0,4,0"/>
                                                <Button Content="Từ chối" Command="{Binding DataContext.RejectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="26" Padding="8,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Đang chuẩn bị">
                        <DataGrid ItemsSource="{Binding ConfirmedMemberOrders}" IsReadOnly="True" Margin="0,6,0,0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderNumber}" Width="130"/>
                                <DataGridTextColumn Header="Máy" Binding="{Binding MachineCode}" Width="75"/>
                                <DataGridTextColumn Header="Hội viên" Binding="{Binding CustomerName}" Width="140"/>
                                <DataGridTemplateColumn Header="Món đang chuẩn bị" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding ProductName}" ToolTip="{Binding Note}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                                <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentMethod, Converter={StaticResource PaymentMethodTextConverter}}" Width="100"/>
                                <DataGridTextColumn Header="Tình trạng tiền" Binding="{Binding PaymentStatus, Converter={StaticResource PaymentStatusTextConverter}}" Width="115"/>
                                <DataGridTemplateColumn Header="Xử lý" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="ĐÃ PHỤC VỤ" Command="{Binding DataContext.FulfillOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PrimaryButton}" Height="26" Padding="8,2" Margin="0,0,4,0"/>
                                                <Button Content="HỦY / HOÀN" Command="{Binding DataContext.RejectOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Height="26" Padding="8,2"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
