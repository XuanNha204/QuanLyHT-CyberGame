<UserControl x:Class="CyberGame.Client.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CyberGame.Client.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1180"
             Background="{StaticResource BackgroundBrush}">

    <Grid>
        <!-- Centered Card -->
        <Border Width="440" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="36">
            <StackPanel>
                <!-- Brand Header -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#EFF6FF" CornerRadius="8" Padding="12,8" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="CYBERGAME MANAGER" 
                                   Foreground="{StaticResource PrimaryBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="16"/>
                    </Border>
                    <TextBlock Text="Đăng nhập hệ thống" 
                               Style="{StaticResource Heading1}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Phần mềm quản trị &amp; vận hành phòng máy" 
                               Style="{StaticResource MutedText}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Error Message Banner -->
                <Border Background="#FEF2F2" 
                        BorderBrush="{StaticResource DangerBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,8" 
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="{StaticResource DangerBrush}" 
                               FontSize="13" 
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Username Input -->
                <TextBlock Text="Tên đăng nhập" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TxtUsername"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource StandardTextBox}" 
                         Margin="0,0,0,16"/>

                <!-- Password Input -->
                <TextBlock Text="Mật khẩu" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="TxtPassword" 
                             Style="{StaticResource StandardPasswordBox}" 
                             PasswordChanged="PasswordBox_PasswordChanged"
                             Margin="0,0,0,16"/>

                <!-- Remember Me -->
                <CheckBox Content="Ghi nhớ tài khoản trên máy này" 
                          IsChecked="{Binding RememberMe}" 
                          FontFamily="{StaticResource BaseFontFamily}"
                          FontSize="13"
                          Foreground="{StaticResource ForegroundBrush}"
                          Margin="0,0,0,20"/>

                <!-- Login Button -->
                <Button Content="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}, ConverterParameter='Đang đăng nhập...', FallbackValue='ĐĂNG NHẬP'}" 
                        Command="{Binding LoginCommand}" 
                        Style="{StaticResource PrimaryButton}" 
                        Height="42"
                        FontSize="14"
                        Margin="0,0,0,24"/>

                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,20"/>

                <!-- Quick Fill Test Accounts -->
                <TextBlock Text="Tài khoản thử nghiệm phát triển:" 
                           Style="{StaticResource MutedText}" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,8"/>
                <UniformGrid Columns="3" Margin="0,0,0,8">
                    <Button Content="Chủ quán" 
                            Command="{Binding FillOwnerCommand}" 
                            Click="PresetButton_Click"
                            Style="{StaticResource OutlineButton}" 
                            Height="32" 
                            FontSize="12"
                            Margin="2,0"/>
                    <Button Content="Thu ngân" 
                            Command="{Binding FillCashierCommand}" 
                            Click="PresetButton_Click"
                            Style="{StaticResource OutlineButton}" 
                            Height="32" 
                            FontSize="12"
                            Margin="2,0"/>
                    <Button Content="Kỹ thuật" 
                            Command="{Binding FillTechCommand}" 
                            Click="PresetButton_Click"
                            Style="{StaticResource OutlineButton}" 
                            Height="32" 
                            FontSize="12"
                            Margin="2,0"/>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
