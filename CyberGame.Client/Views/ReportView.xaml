<UserControl x:Class="CyberGame.Client.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Báo cáo doanh thu &amp; Thống kê kinh doanh" Style="{StaticResource Heading1}"/>
                <TextBlock Text="Phân tích cơ cấu doanh thu giờ máy, dịch vụ và danh sách mặt hàng bán chạy nhất" Style="{StaticResource MutedText}"/>
            </StackPanel>
            <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource OutlineButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <!-- Range Presets Filter -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="Khoảng thời gian:" Style="{StaticResource BodyText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox SelectedItem="{Binding SelectedPreset}" Width="150" Margin="0,0,16,0">
                <ComboBoxItem Content="Hôm nay"/>
                <ComboBoxItem Content="7 ngày qua" IsSelected="True"/>
                <ComboBoxItem Content="30 ngày qua"/>
            </ComboBox>

            <TextBlock Text="{Binding FromDate, StringFormat='Từ: {0:dd/MM/yyyy}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding ToDate, StringFormat='Đến: {0:dd/MM/yyyy}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 3 KPI Cards -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource CardPanel}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="TỔNG DOANH THU" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}, FallbackValue='0 đ'}" 
                               Style="{StaticResource Heading1}" 
                               Foreground="{StaticResource PrimaryBrush}" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="4,0,4,0">
                <StackPanel>
                    <TextBlock Text="DOANH THU TIỀN GIỜ MÁY" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalMachineRevenue, Converter={StaticResource CurrencyConverter}, FallbackValue='0 đ'}" 
                               Style="{StaticResource Heading1}" 
                               Foreground="{StaticResource InfoBrush}" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardPanel}" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="DOANH THU DỊCH VỤ &amp; ĐỒ ĂN" Style="{StaticResource MutedText}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalServiceRevenue, Converter={StaticResource CurrencyConverter}, FallbackValue='0 đ'}" 
                               Style="{StaticResource Heading1}" 
                               Foreground="{StaticResource AccentBrush}" 
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Tables Split: Daily Breakdown & Top Selling Products -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Daily Revenue -->
            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Doanh thu theo từng ngày" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DailyRevenues}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ngày" Binding="{Binding Date, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                            <DataGridTextColumn Header="Tiền giờ" Binding="{Binding MachineRevenue, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                            <DataGridTextColumn Header="Dịch vụ" Binding="{Binding ServiceRevenue, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                            <DataGridTextColumn Header="Tổng cộng" Binding="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Product Sales -->
            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Top mặt hàng bán chạy" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TopProducts}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Nhóm hàng" Binding="{Binding CategoryName}" Width="130"/>
                            <DataGridTextColumn Header="Số lượng bán" Binding="{Binding QuantitySold, StringFormat='{}{0:N0}'}" Width="100"/>
                            <DataGridTextColumn Header="Tổng thu" Binding="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
