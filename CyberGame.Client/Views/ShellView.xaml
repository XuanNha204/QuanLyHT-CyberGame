<UserControl x:Class="CyberGame.Client.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:CyberGame.Client.ViewModels"
             xmlns:views="clr-namespace:CyberGame.Client.Views"
             mc:Ignorable="d" 
             d:DesignHeight="760" d:DesignWidth="1200"
             Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StationViewModel}">
            <views:StationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerViewModel}">
            <views:CustomerView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShiftViewModel}">
            <views:ShiftView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InvoiceViewModel}">
            <views:InvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border Grid.Column="0" 
                Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="16,20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="CYBERGAME" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="MANAGER" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="{Binding BranchName}" Style="{StaticResource MutedText}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="4,12">
                    <StackPanel>
                        <RadioButton Content="🖥  Tổng quan" 
                                     GroupName="NavMenu" 
                                     IsChecked="True" 
                                     Command="{Binding NavigateDashboardCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="💻  Phòng máy" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateStationsCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="👥  Hội viên" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateCustomersCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="🛒  Bán hàng (POS)" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigatePosCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="📦  Kho hàng" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateInventoryCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="⏱  Ca làm việc" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateShiftsCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="🧾  Hóa đơn" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateInvoicesCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="🛠  Bảo trì sự cố" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateMaintenanceCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>

                        <RadioButton Content="📊  Báo cáo doanh thu" 
                                     GroupName="NavMenu" 
                                     Command="{Binding NavigateReportsCommand}" 
                                     Style="{StaticResource SidebarNavButton}"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Profile & Status Widget -->
                <Border Grid.Row="2" Padding="14,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#F8FAFC">
                    <StackPanel>
                        <!-- User Info -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#DBEAFE" Margin="0,0,10,0">
                                <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserFullName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserRole}" Style="{StaticResource MutedText}" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- Shift Status Badge -->
                        <Border CornerRadius="4" Padding="8,4" Margin="0,0,0,12"
                                Background="{Binding HasActiveShift, Converter={StaticResource BoolToVisConverter}, ConverterParameter='#DCFCE7', FallbackValue='#FFEDD5'}">
                            <TextBlock Text="{Binding ShiftBadgeText}" 
                                       FontSize="11" 
                                       FontWeight="Bold" 
                                       HorizontalAlignment="Center"
                                       Foreground="{Binding HasActiveShift, Converter={StaticResource BoolToVisConverter}, ConverterParameter='#15803D', FallbackValue='#C2410C'}"/>
                        </Border>

                        <!-- Logout Button -->
                        <Button Content="Đăng xuất" 
                                Command="{Binding LogoutCommand}" 
                                Style="{StaticResource OutlineButton}" 
                                Height="30" 
                                FontSize="12"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Right Main Application Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Border Grid.Row="0" 
                    Background="{StaticResource SurfaceBrush}" 
                    BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="0,0,0,1" 
                    Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTitle}" Style="{StaticResource Heading2}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Server Status Indicator -->
                        <Border Background="#DCFCE7" CornerRadius="12" Padding="10,4" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="API Sẵn sàng" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11"/>
                            </StackPanel>
                        </Border>

                        <!-- Live Clock -->
                        <TextBlock Text="{Binding CurrentTimeString}" Style="{StaticResource CodeText}" Foreground="{StaticResource MutedForegroundBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active View Content -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</UserControl>
